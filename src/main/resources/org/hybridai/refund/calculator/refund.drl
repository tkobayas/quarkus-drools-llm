package org.hybridai.refund.calculator;

import org.hybridai.refund.model.*;

rule "遅延による返金対象判定" when
	Flight( $delay : delayInMinutes >= 60 )
then
	insert(new RefundAmount( 20 * $delay ));
end

rule "高齢者向け返金増額" when
	Customer( age > 65 )
	$r: RefundAmount()
then
	$r.setAmount( $r.getAmount() * 1.1 );
end